<Window x:Class="Blitztext.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blitztext.Windows"
        Title="Blitztext" Height="660" Width="780"
        MinHeight="560" MinWidth="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Padding="24,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E2748" Offset="0" />
                    <GradientStop Color="#111827" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="12" ClipToBounds="True">
                    <Image Source="Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Blitztext" FontSize="21" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="StatusText" Text="Bereit" Margin="0,3,0,0" Foreground="#AEB7CC" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Background="#26FFFFFF" CornerRadius="9" Padding="9,3">
                    <TextBlock x:Name="VersionText" Foreground="#E5E7EB" FontSize="11.5" FontWeight="SemiBold" Text="v0.0.0" />
                </Border>
            </Grid>
        </Border>

        <!-- ============================ Body: sidebar navigation ============================ -->
        <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}" Margin="14">

            <!-- Allgemein -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Text="Allgemein" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Aufnahme &amp; Sprache" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Hotkey-Modus" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="HotkeyModeCombo" SelectionChanged="SettingsControl_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Sprache" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="LanguageTextBox" TextChanged="SettingsTextBox_Changed" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="SecureLocalModeCheckBox" Content="Sicherer lokaler Modus"
                                      Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                            <TextBlock Text="Transkribiert ausschließlich lokal mit whisper.cpp – es werden keine Audiodaten an einen Server gesendet."
                                       Style="{StaticResource HelpText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Programmstart" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="StartupCheckBox" Content="Blitztext beim Anmelden starten"
                                      Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Tastenkürzel -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE765;" />
                        <TextBlock Text="Tastenkürzel" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tastenkürzel" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Lege fest, mit welchen Tasten die Workflows ausgelöst werden. Klicke ein Feld an und drücke die gewünschte Kombination."
                                       Style="{StaticResource HelpText}" Margin="0,0,0,12" />
                            <local:HotkeyEditorControl x:Name="HotkeyEditor" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Konto und Zugang -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE77B;" />
                        <TextBlock Text="Konto &amp; Zugang" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OpenAI API-Key" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ApiKeyStatusText" Style="{StaticResource HelpText}" Margin="0,0,0,8" />
                            <TextBlock Text="Neuer API-Key" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="ApiKeyBox" />
                            <Button Content="API Key speichern" Style="{StaticResource PrimaryButton}"
                                    Click="SaveApiKeyButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Lokale Daten" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Entfernt den gespeicherten API-Key und setzt alle Einstellungen auf diesem Gerät zurück."
                                       Style="{StaticResource HelpText}" Margin="0,0,0,10" />
                            <Button Content="Lokale Einstellungen und Key löschen"
                                    Click="CleanupButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Schreiben -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE70F;" />
                        <TextBlock Text="Schreiben" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Schreiben (Blitztext+)" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Diese Optionen steuern, wie der diktierte Text mit Blitztext+ aufbereitet wird."
                                       Style="{StaticResource HelpText}" Margin="0,0,0,8" />

                            <TextBlock Text="Schreibstil" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ToneCombo" SelectionChanged="SettingsControl_Changed" />

                            <TextBlock Text="Eigennamen, kommagetrennt" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CustomTermsTextBox" TextChanged="SettingsTextBox_Changed" />

                            <TextBlock Text="Kontext" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ContextTextBox" TextChanged="SettingsTextBox_Changed" />

                            <TextBlock Text="Blitztext+ Anweisung" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ImproverPromptTextBox" AcceptsReturn="True" Height="96"
                                     TextWrapping="Wrap" VerticalContentAlignment="Stretch"
                                     VerticalScrollBarVisibility="Auto" TextChanged="SettingsTextBox_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Lokale Modelle -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE896;" />
                        <TextBlock Text="Lokale Modelle" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="whisper.cpp Runtime" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="LocalRuntimeStatusText" Style="{StaticResource HelpText}" Margin="0,0,0,8" />
                            <Button x:Name="InstallRuntimeButton" Content="whisper.cpp installieren"
                                    Click="InstallRuntimeButton_Click" HorizontalAlignment="Left" />
                            <ProgressBar x:Name="RuntimeProgressBar" Height="8" Minimum="0" Maximum="1"
                                         Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Modell" Style="{StaticResource SectionTitle}" />
                            <ComboBox x:Name="LocalModelCombo" SelectionChanged="SettingsControl_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="InstallModelButton" Content="Ausgewähltes Modell installieren"
                                    Click="InstallModelButton_Click" HorizontalAlignment="Left" />
                            <ProgressBar x:Name="ModelProgressBar" Height="8" Minimum="0" Maximum="1"
                                         Visibility="Collapsed" Margin="0,8,0,0" />
                            <TextBlock x:Name="LocalModelStatusText" Style="{StaticResource HelpText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
