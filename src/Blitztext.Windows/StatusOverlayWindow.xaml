<Window x:Class="Blitztext.Windows.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Tastenkürzel …" Click="HotkeysMenuItem_Click" />
            <MenuItem Header="Einstellungen …" Click="SettingsMenuItem_Click" />
            <Separator />
            <MenuItem Header="Beenden" Click="QuitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="PillBorder"
            CornerRadius="18"
            Background="#E6111827"
            Padding="14,7"
            Cursor="Hand"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseMove="Pill_MouseMove"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#94A3B8" VerticalAlignment="Center" />
            <StackPanel x:Name="LevelBars"
                        Orientation="Horizontal"
                        Height="16"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
            <TextBlock x:Name="StatusLabel"
                       Text="Blitztext"
                       Margin="10,0,2,0"
                       Foreground="#E5E7EB"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
