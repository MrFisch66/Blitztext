<Window x:Class="Blitztext.Windows.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext – Tastenkürzel"
        Width="470" SizeToContent="Height"
        MinWidth="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <StackPanel Margin="18">
        <TextBlock Text="Tastenkürzel" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Klicke ein Feld an und drücke die gewünschte Kombination. Reine Modifier wie Ctrl + Win sind erlaubt (mindestens zwei Tasten). Escape setzt den Standard zurück. Solange dieses Fenster offen ist, sind die Hotkeys pausiert."
                   Style="{StaticResource HelpText}" Margin="0,0,0,12" />

        <Border Padding="12" Margin="0,0,0,10" Background="White" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blitztext" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Sprache rein. Text raus." Style="{StaticResource HelpText}" />
                </StackPanel>
                <TextBox x:Name="TranscriptionHotkeyBox" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                <CheckBox x:Name="TranscriptionEnabledCheckBox" Grid.Column="2" Content="Aktiv" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
            </Grid>
        </Border>

        <Border Padding="12" Margin="0,0,0,10" Background="White" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blitztext Lokal" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Nur lokal. Kein Server." Style="{StaticResource HelpText}" />
                </StackPanel>
                <TextBox x:Name="LocalTranscriptionHotkeyBox" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                <CheckBox x:Name="LocalTranscriptionEnabledCheckBox" Grid.Column="2" Content="Aktiv" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
            </Grid>
        </Border>

        <Border Padding="12" Margin="0,0,0,10" Background="White" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blitztext+" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Geschrieben sprechen." Style="{StaticResource HelpText}" />
                </StackPanel>
                <TextBox x:Name="TextImproverHotkeyBox" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                <CheckBox x:Name="TextImproverEnabledCheckBox" Grid.Column="2" Content="Aktiv" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
            </Grid>
        </Border>

        <Border Padding="12" Margin="0,0,0,10" Background="White" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blitztext $%&amp;!" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Frust rein. Entspannt raus." Style="{StaticResource HelpText}" />
                </StackPanel>
                <TextBox x:Name="DampfHotkeyBox" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                <CheckBox x:Name="DampfEnabledCheckBox" Grid.Column="2" Content="Aktiv" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
            </Grid>
        </Border>

        <Border Padding="12" Margin="0,0,0,10" Background="White" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blitztext :)" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Text rein. Emojis dazu." Style="{StaticResource HelpText}" />
                </StackPanel>
                <TextBox x:Name="EmojiHotkeyBox" Grid.Column="1" Margin="10,0,0,0" IsReadOnly="True"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" PreviewKeyUp="Hotkey_PreviewKeyUp"
                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                <CheckBox x:Name="EmojiEnabledCheckBox" Grid.Column="2" Content="Aktiv" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusLabel" Style="{StaticResource HelpText}" Margin="2,4,0,0" Text="" />
        <Button x:Name="CloseButton" Content="Schließen" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="110" />
    </StackPanel>
</Window>
