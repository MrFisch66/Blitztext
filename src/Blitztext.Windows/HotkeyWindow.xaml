<Window x:Class="Blitztext.Windows.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blitztext.Windows"
        Title="Blitztext – Tastenkürzel"
        Width="470" SizeToContent="Height"
        MinWidth="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="Tastenkürzel" Style="{StaticResource SectionTitle}" />
        <local:HotkeyEditorControl x:Name="Editor" />
        <Button x:Name="CloseButton" Content="Schließen" Click="CloseButton_Click"
                HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="110" />
    </StackPanel>
</Window>
